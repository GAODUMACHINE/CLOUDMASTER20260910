# 复制为 .env 并填入真实值。严禁将真实密钥提交到仓库。
#
# 推荐：阿里云百炼公共端点（OpenAI 兼容）
QWEN_API_KEY=sk-your-key-here
QWEN_API_HOST=dashscope.aliyuncs.com
# 生产模型必须满足「首 token P95 ≤ 2s」(TC-PERF-001)。
# qwen-flash 实测首 token P50≈0.3s；qwen3.5-flash 是思考模型（首 token≈14s），不满足门禁。
QWEN_MODEL=qwen-flash
# QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
#
# 备选：专属工作空间端点（部分 key 会返回 403 Workspace endpoint access denied）
# QWEN_API_HOST=ws-<workspace-id>.cn-beijing.maas.aliyuncs.com
#
# CM_STUB=1 时改用本地确定性替身（零额度/不触网），仅用于未开通模型前跑通全流程
CM_STUB=0
#
# 人工审核台访问令牌：留空则审核台一律 403（默认不开放，最小暴露）。
# 该链路会返回会话上下文，属敏感数据；仅在需要处理 L2 高危工单时于本机设置。
# 真实令牌只写在 gitignored 的 .env 中，绝不入库、绝不硬编码。
CM_REVIEWER_TOKEN=
#
# ============================================================
# 邮件收发（ADR-009）。留空则对应通道关闭：发信会如实返回「未配置」，收信接口返回 503。
# 这些都是**系统侧账号**凭据，只写在本机 gitignored 的 .env，绝不入库。
# ============================================================
# 发信 SMTP（示例为 QQ 邮箱；Outlook 用 smtp-mail.outlook.com:587 + starttls）
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
# 发件人地址：留空则回退为 SMTP_USER
SMTP_FROM=
# 安全模式：ssl（465，默认） / starttls（587） / plain（仅本地调试，明文不推荐）
SMTP_SECURITY=ssl
#
# 收信 IMAP（用于接收回信 / 退信 / STOP 退订）
IMAP_HOST=
IMAP_PORT=993
IMAP_USER=
IMAP_PASSWORD=
IMAP_FOLDER=INBOX
#
# 报告发件人显示名
MAIL_FROM_NAME=LightCloudMaster 拾光云上
